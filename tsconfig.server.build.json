{
  "//": "Emits the API to dist-server/ for `npm run build:server`; type-checking for `npm run build` uses tsconfig.server.json.",
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.build.tsbuildinfo",
    "noEmit": false,
    "rootDir": "./server/src",
    "outDir": "./dist-server",
    "sourceMap": true
  },
  "include": ["server/src"],
  "exclude": ["server/**/*.test.ts"]
}
