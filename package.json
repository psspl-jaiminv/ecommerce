{
  "name": "ecommerce",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "dev:all": "concurrently --kill-others-on-fail --names web,api --prefix-colors cyan,magenta \"npm:dev\" \"npm:dev:server\"",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.build.json",
    "start:server": "node --enable-source-maps dist-server/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "node-pg-migrate up -m server/migrations",
    "db:migrate:down": "node-pg-migrate down -m server/migrations",
    "db:migrate:create": "node-pg-migrate create -m server/migrations -j sql",
    "test": "vitest run",
    "test:server": "vitest run --project server"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^5.1.2"
  }
}
