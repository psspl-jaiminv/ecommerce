# Copy to `.env` and adjust. Values below are local-development placeholders, not secrets.

# --- API server ---
NODE_ENV=development
PORT=3001
# Origin of the web app
APP_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=7
DATABASE_URL=postgres://app:app@localhost:5432/app

# --- Tests: this database is migrated and truncated by the test suite; never point it at real data ---
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app_test

# --- docker compose overrides (optional; keep the URLs above in sync) ---
# POSTGRES_USER=app
# POSTGRES_PASSWORD=app
# POSTGRES_PORT=5432
